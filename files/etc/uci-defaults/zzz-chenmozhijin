#!/bin/sh

has_package() {
  if command -v apk >/dev/null 2>&1; then
    apk info -e "$1" >/dev/null 2>&1
  else
    opkg list-installed 2>/dev/null | grep -Eq "^$1( - |$)"
  fi
}

[ -d "/etc/init.d" ] && chmod +x /etc/init.d/*
[ -f "/etc/firewall.user" ] && chmod +x /etc/firewall.user
[ -f "/etc/crontabs/root" ] && chmod 600 /etc/crontabs/root
[ -f "/etc/dropbear/authorized_keys" ] && chmod 600 /etc/dropbear/authorized_keys

if [ -f "/usr/share/cmzj/openwrt-k_tool.sh" ]; then
  chmod +x /usr/share/cmzj/openwrt-k_tool.sh
  ln -sf /usr/share/cmzj/openwrt-k_tool.sh /bin/openwrt-k
fi

sed -i "/^DISTRIB_DESCRIPTION='/s/'$/ Compiled by Char ONE'/" /etc/openwrt_release 2>/dev/null || true

exit 0
