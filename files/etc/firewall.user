#!/bin/sh

# ============================================================
# Webex Meetings & Calling UDP Bypass for OpenClash/fw4
# 绕过 Clash 内核，直连主路由，解决 UDP 长连接中断
# 数据来源: https://help.webex.com/en-us/article/WBX264
# ============================================================

# 检查 nftables 是否可用
if ! command -v nft >/dev/null 2>&1; then
    echo "Webex Bypass: nftables not found, exiting."
    exit 0
fi

# 创建 Webex 的 IP 集合 (如果已存在则清空重建)
nft add set inet fw4 webex_media_ipv4 '{ type ipv4_addr; flags interval; }' 2>/dev/null
nft flush set inet fw4 webex_media_ipv4 2>/dev/null

# 批量添加 IP 网段
for cidr in \
    23.89.0.0/16 \
    44.224.0.0/11 \
    62.109.192.0/18 \
    64.68.64.0/18 \
    66.114.160.0/20 \
    66.163.32.0/19 \
    69.26.160.0/19 \
    103.248.36.0/22 \
    114.29.192.0/19 \
    130.248.0.0/16 \
    150.253.128.0/17 \
    170.72.0.0/16 \
    173.39.224.0/19 \
    206.182.192.0/19 \
    207.182.160.0/19 \
    209.197.192.0/19 \
    210.4.192.0/20 \
    216.151.128.0/19 \
    216.239.48.0/20
do
    nft add element inet fw4 webex_media_ipv4 "$cidr" 2>/dev/null
done

# 创建 bypass 链 (如果已存在则清空规则)
nft add chain inet fw4 user_pre_bypass '{ type filter hook prerouting priority -150; policy accept; }' 2>/dev/null
nft flush chain inet fw4 user_pre_bypass 2>/dev/null

# 规则1: UDP 媒体流直连
nft add rule inet fw4 user_pre_bypass ip daddr @webex_media_ipv4 udp dport '{ 53, 5004, 9000, 9001, 5060-5070, 33434-33598, 19560-65535 }' accept

# 规则2: TCP 信令直连 (Webex Calling 使用的少量 IP 段)
nft add rule inet fw4 user_pre_bypass ip daddr '{ 23.89.0.0/16, 62.109.192.0/18, 64.68.64.0/18, 69.26.160.0/19, 170.72.0.0/16, 206.182.192.0/19 }' tcp dport 5300-5308 accept

echo "Webex Bypass: rules applied successfully."